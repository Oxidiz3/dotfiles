[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/home/porter/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main gateway run --replace
WorkingDirectory=/home/porter/.hermes
Environment="PATH=/home/porter/.hermes/hermes-agent/venv/bin:/home/porter/.hermes/hermes-agent/node_modules/.bin:/home/porter/.hermes/node/bin:/home/porter/.local/bin:/home/porter/.cargo/bin:/mnt/c/Program Files/Alacritty/:/mnt/c/Program Files/Oculus/Support/oculus-runtime:/mnt/c/WINDOWS/system32:/mnt/c/WINDOWS:/mnt/c/WINDOWS/System32/Wbem:/mnt/c/WINDOWS/System32/WindowsPowerShell/v1.0/:/mnt/c/WINDOWS/System32/OpenSSH/:/mnt/c/Program Files/NVIDIA Corporation/NVIDIA App/NvDLISR:/mnt/c/Program Files (x86)/NVIDIA Corporation/PhysX/Common:/mnt/c/Program Files/Neovim/bin:/mnt/c/Program Files/nodejs/:/mnt/d/Program Files/Apollo:/mnt/d/Program Files/Apollo/tools:/mnt/c/Program Files/dotnet/:/mnt/c/Program Files/Git/cmd:/mnt/c/Program Files/Calibre2/:/mnt/c/Program Files/Process Lasso/:/mnt/c/Users/mecha/.local/bin:/mnt/c/Users/mecha/AppData/Local/Programs/Python/Python313/Scripts/:/mnt/c/Users/mecha/AppData/Local/Programs/Python/Python313/:/mnt/c/Users/mecha/AppData/Local/Programs/Python/Python314/Scripts/:/mnt/c/Users/mecha/AppData/Local/Programs/Python/Python314/:/mnt/c/Users/mecha/AppData/Local/Programs/Python/Launcher/:/mnt/c/Users/mecha/AppData/Local/Microsoft/WindowsApps:/mnt/c/Users/mecha/AppData/Local/Programs/Microsoft VS Code/bin:/mnt/c/Users/mecha/AppData/Roaming/npm:/mnt/c/Users/mecha/.cache/lm-studio/bin:/mnt/c/Users/mecha/scripts:/mnt/c/ffmpeg/bin:/mnt/c/Users/mecha/AppData/Local/PowerToys/DSCModules/:/mnt/c/WINDOWS/System32/WindowsPowerShell/v1.0:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/home/porter/.hermes/hermes-agent/venv"
Environment="HERMES_HOME=/home/porter/.hermes"
Restart=always
RestartSec=5
RestartMaxDelaySec=300
RestartSteps=5
RestartForceExitStatus=75
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
TimeoutStopSec=210
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

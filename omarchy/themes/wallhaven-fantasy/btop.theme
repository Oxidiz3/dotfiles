# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#040710"

# Main text color
theme[main_fg]="#cfd8e9"

# Title color for boxes
theme[title]="#cfd8e9"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#4775d8"

# Background color of selected item in processes box. #1d2028 maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #1d2028 gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#1d2028"

# Foreground color of selected item in processes box. Use #cfd8e9 so
# the row text stays readable on the lighter_bg highlight; the previous
# #4775d8 produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#cfd8e9"

# Color of inactive/disabled text
theme[inactive_fg]="#5b5d63"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #d6deec caps at #ffffff when the foreground is already pure white, so we
# just bind it to #cfd8e9 directly.
theme[graph_text]="#cfd8e9"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #1d2028 collapsed to the main fg.
theme[meter_bg]="#1d2028"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #309132 for a distinct accent instead of #d6deec which capped to white.
theme[proc_misc]="#309132"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#d15453"
theme[mem_box]="#e47c77"
theme[net_box]="#749cef"
theme[proc_box]="#4775d8"

# Box divider line and small boxes line color
theme[div_line]="#5b5d63"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#e47c77"
theme[temp_mid]="#6ab368"
theme[temp_end]="#749cef"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#309132"
theme[cpu_mid]="#4775d8"
theme[cpu_end]="#d15453"

# Mem/Disk free meter
theme[free_start]="#d15453"
theme[free_mid]="#4775d8"
theme[free_end]="#309132"

# Mem/Disk cached meter
theme[cached_start]="#4775d8"
theme[cached_mid]="#309132"
theme[cached_end]="#d15453"

# Mem/Disk available meter
theme[available_start]="#6ab368"
theme[available_mid]="#749cef"
theme[available_end]="#749cef"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#e47c77"
theme[used_mid]="#309132"
theme[used_end]="#4775d8"

# Download graph colors
theme[download_start]="#6ab368"
theme[download_mid]="#749cef"
theme[download_end]="#749cef"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#e47c77"
theme[upload_mid]="#309132"
theme[upload_end]="#4775d8"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#309132"
theme[process_mid]="#4775d8"
theme[process_end]="#d15453"
